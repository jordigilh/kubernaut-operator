{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "postgresql": { "$ref": "#/$defs/postgresql" },
    "valkey": { "$ref": "#/$defs/valkey" },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiKey": { "type": "string", "minLength": 1 }
          }
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aiAnalysis": { "type": "string", "minLength": 1 },
            "signalProcessing": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": { "type": "array", "items": { "type": "string" } }
          }
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["RuntimeDefault", "Unconfined", "Localhost"] }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "serviceName": { "type": "string", "minLength": 1 },
        "secretName": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "sslMode": { "type": "string", "enum": ["require", "verify-ca", "verify-full"] },
        "image": { "$ref": "#/$defs/image" },
        "commandMode": { "type": "string", "enum": ["rhel", "official"] },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": { "type": "string", "minLength": 1 },
            "validityDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        },
        "persistence": { "$ref": "#/$defs/persistence" },
        "securityContext": { "$ref": "#/$defs/securityContext" },
        "resources": { "type": "object" }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "serviceName": { "type": "string", "minLength": 1 },
        "secretName": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/$defs/image" },
        "persistence": { "$ref": "#/$defs/persistence" },
        "securityContext": { "$ref": "#/$defs/securityContext" },
        "resources": { "type": "object" }
      }
    }
  }
}
